<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.jobos.desktop.controller.poster.JobPostsController"
      spacing="24" styleClass="page-container">
    <padding>
        <Insets topRightBottomLeft="24"/>
    </padding>
    
    <HBox alignment="CENTER_LEFT" spacing="16">
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="Job Posts" styleClass="h2"/>
            <Label fx:id="totalJobsLabel" text="0 job posts" styleClass="label-secondary"/>
        </VBox>
        <ComboBox fx:id="statusFilter" promptText="Filter by status"/>
        <Button text="+ Post New Job" styleClass="button-primary" onAction="#onCreateJob"/>
    </HBox>
    
    <VBox fx:id="jobsList" spacing="12" VBox.vgrow="ALWAYS"/>
    
    <HBox fx:id="paginationContainer" alignment="CENTER" spacing="16">
        <padding>
            <Insets top="16"/>
        </padding>
    </HBox>
</VBox>
