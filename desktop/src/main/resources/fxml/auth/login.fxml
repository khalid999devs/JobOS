<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<HBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.jobos.desktop.controller.auth.LoginController"
      style="-fx-background-color: white;">
    
    <VBox alignment="CENTER" spacing="0" HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-min-width: 480; -fx-max-width: 520;">
        <padding>
            <Insets top="40" right="60" bottom="40" left="60"/>
        </padding>
        
        <VBox alignment="CENTER_LEFT" spacing="32" maxWidth="380">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="JobOS" style="-fx-text-fill: #111827; -fx-font-size: 22px; -fx-font-weight: 800;"/>
            </HBox>
            
            <VBox spacing="8">
                <Label text="Welcome Back!" style="-fx-text-fill: #111827; -fx-font-size: 28px; -fx-font-weight: 700;"/>
                <Label text="Sign in to access your dashboard and continue managing your job activities." styleClass="label-secondary" wrapText="true"/>
            </VBox>
            
            <VBox spacing="20">
                <VBox spacing="6">
                    <Label text="Email" styleClass="form-label"/>
                    <TextField fx:id="emailField" promptText="Enter your email" styleClass="text-field"/>
                </VBox>
                
                <VBox spacing="6">
                    <HBox alignment="CENTER_LEFT">
                        <Label text="Password" styleClass="form-label"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Hyperlink text="Forgot Password?" onAction="#onForgotPassword" style="-fx-text-fill: #0F766E; -fx-font-size: 13px;"/>
                    </HBox>
                    <PasswordField fx:id="passwordField" promptText="Enter your password" styleClass="text-field"/>
                </VBox>
            </VBox>
            
            <VBox spacing="16">
                <Label fx:id="errorLabel" styleClass="form-error" visible="false" managed="false" wrapText="true"/>
                <Button fx:id="loginButton" text="Sign In" onAction="#onLogin" styleClass="button-primary-teal" maxWidth="Infinity"/>
            </VBox>
            
            <HBox alignment="CENTER" spacing="4">
                <Label text="Don't have an Account?" styleClass="label-tertiary"/>
                <Hyperlink text="Sign Up" onAction="#onSignUp" style="-fx-text-fill: #0F766E; -fx-font-weight: 600;"/>
            </HBox>
        </VBox>
    </VBox>
    
    <StackPane HBox.hgrow="ALWAYS" styleClass="auth-hero-panel">
        <VBox alignment="CENTER" spacing="24" maxWidth="420">
            <padding>
                <Insets topRightBottomLeft="60"/>
            </padding>
            
            <Label text="Find Your Dream Job with JobOS" styleClass="auth-hero-title" wrapText="true"/>
            
            <VBox spacing="8" style="-fx-background-color: rgba(255,255,255,0.1); -fx-background-radius: 12; -fx-padding: 20;">
                <Label text="❝" style="-fx-text-fill: rgba(255,255,255,0.6); -fx-font-size: 32px;"/>
                <Label text="JobOS has completely transformed our hiring process. It's reliable, efficient, and ensures our recruitment is always top-notch." styleClass="auth-hero-quote" wrapText="true"/>
                
                <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 12 0 0 0;">
                    <StackPane style="-fx-background-color: white; -fx-background-radius: 20; -fx-min-width: 40; -fx-min-height: 40;">
                        <Label text="JD" style="-fx-text-fill: #0F766E; -fx-font-weight: 700;"/>
                    </StackPane>
                    <VBox spacing="2">
                        <Label text="John Davidson" style="-fx-text-fill: white; -fx-font-weight: 600; -fx-font-size: 14px;"/>
                        <Label text="HR Manager at TechCorp" style="-fx-text-fill: rgba(255,255,255,0.7); -fx-font-size: 12px;"/>
                    </VBox>
                </HBox>
            </VBox>
            
            <VBox alignment="CENTER" spacing="12" style="-fx-padding: 20 0 0 0;">
                <Label text="TRUSTED BY 1000+ COMPANIES" style="-fx-text-fill: rgba(255,255,255,0.5); -fx-font-size: 11px; -fx-letter-spacing: 1;"/>
                <HBox alignment="CENTER" spacing="24">
                    <Label text="Google" style="-fx-text-fill: white; -fx-font-weight: 600; -fx-font-size: 14px;"/>
                    <Label text="Microsoft" style="-fx-text-fill: white; -fx-font-weight: 600; -fx-font-size: 14px;"/>
                    <Label text="Amazon" style="-fx-text-fill: white; -fx-font-weight: 600; -fx-font-size: 14px;"/>
                    <Label text="Meta" style="-fx-text-fill: white; -fx-font-weight: 600; -fx-font-size: 14px;"/>
                </HBox>
            </VBox>
        </VBox>
    </StackPane>
</HBox>
