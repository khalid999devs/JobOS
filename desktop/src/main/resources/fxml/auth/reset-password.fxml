<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.jobos.desktop.controller.auth.ResetPasswordController"
           style="-fx-background-color: #FAFAFA;">
    
    <VBox alignment="CENTER" spacing="24">
        <padding>
            <Insets topRightBottomLeft="40"/>
        </padding>
        
        <VBox styleClass="auth-card" spacing="24">
            <VBox spacing="8">
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Button text="←" onAction="#onBack" styleClass="button-ghost" style="-fx-font-size: 18px;"/>
                    <Label text="New Password" styleClass="auth-title"/>
                </HBox>
                <Label text="Enter the code from your email and create a new password" styleClass="auth-subtitle" wrapText="true"/>
            </VBox>
            
            <VBox spacing="16">
                <VBox styleClass="form-field">
                    <Label text="Reset Code" styleClass="form-label"/>
                    <TextField fx:id="codeField" promptText="Enter 6-digit code"/>
                </VBox>
                
                <VBox styleClass="form-field">
                    <Label text="New Password" styleClass="form-label"/>
                    <PasswordField fx:id="passwordField" promptText="Enter new password (min 8 characters)"/>
                </VBox>
                
                <VBox styleClass="form-field">
                    <Label text="Confirm Password" styleClass="form-label"/>
                    <PasswordField fx:id="confirmPasswordField" promptText="Confirm new password"/>
                </VBox>
            </VBox>
            
            <VBox spacing="12">
                <Label fx:id="errorLabel" styleClass="form-error" visible="false" managed="false" wrapText="true"/>
                <Button fx:id="submitButton" text="Reset Password" onAction="#onSubmit" styleClass="button-primary" maxWidth="Infinity"/>
            </VBox>
            
            <HBox alignment="CENTER" spacing="4">
                <Label text="Didn't receive the code?" styleClass="label-tertiary"/>
                <Hyperlink text="Resend" onAction="#onResend"/>
            </HBox>
        </VBox>
    </VBox>
</StackPane>
