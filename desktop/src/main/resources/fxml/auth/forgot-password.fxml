<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.jobos.desktop.controller.auth.ForgotPasswordController"
           style="-fx-background-color: #FAFAFA;">
    
    <VBox alignment="CENTER" spacing="24">
        <padding>
            <Insets topRightBottomLeft="40"/>
        </padding>
        
        <VBox styleClass="auth-card" spacing="24">
            <VBox spacing="8">
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Button text="←" onAction="#onBack" styleClass="button-ghost" style="-fx-font-size: 18px;"/>
                    <Label text="Reset Password" styleClass="auth-title"/>
                </HBox>
                <Label text="Enter your email to receive a reset code" styleClass="auth-subtitle" wrapText="true"/>
            </VBox>
            
            <VBox spacing="16">
                <VBox styleClass="form-field">
                    <Label text="Email" styleClass="form-label"/>
                    <TextField fx:id="emailField" promptText="Enter your email"/>
                </VBox>
            </VBox>
            
            <VBox spacing="12">
                <Label fx:id="errorLabel" styleClass="form-error" visible="false" managed="false"/>
                <Label fx:id="successLabel" style="-fx-text-fill: #059669; -fx-font-size: 13px;" visible="false" managed="false" wrapText="true"/>
                <Button fx:id="submitButton" text="Send Reset Code" onAction="#onSubmit" styleClass="button-primary" maxWidth="Infinity"/>
            </VBox>
            
            <HBox alignment="CENTER" spacing="4">
                <Label text="Remember your password?" styleClass="label-tertiary"/>
                <Hyperlink text="Sign in" onAction="#onSignIn"/>
            </HBox>
        </VBox>
    </VBox>
</StackPane>
