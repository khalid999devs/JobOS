<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.jobos.desktop.controller.seeker.SeekerDashboardController"
      spacing="28" style="-fx-background-color: #FAFAFA;">
    <padding>
        <Insets top="32" right="32" bottom="32" left="32"/>
    </padding>
    
    <HBox alignment="CENTER_LEFT" spacing="16">
        <VBox spacing="6" HBox.hgrow="ALWAYS">
            <Label fx:id="welcomeLabel" text="Welcome back!" style="-fx-text-fill: #111827; -fx-font-size: 26px; -fx-font-weight: 700;"/>
            <Label text="Here's an overview of your job search activity" style="-fx-text-fill: #6B7280; -fx-font-size: 14px;"/>
        </VBox>
        <Button onAction="#onBrowseJobs" styleClass="button-primary-teal">
            <graphic>
                <HBox spacing="8" alignment="CENTER">
                    <FontIcon iconLiteral="fas-search" iconSize="14" iconColor="white"/>
                    <Label text="Find Jobs" style="-fx-text-fill: white; -fx-font-weight: 600;"/>
                </HBox>
            </graphic>
        </Button>
    </HBox>
    
    <HBox fx:id="statsContainer" spacing="20">
        <VBox styleClass="stat-card-modern" HBox.hgrow="ALWAYS" spacing="12">
            <HBox alignment="CENTER_LEFT" spacing="12">
                <StackPane style="-fx-background-color: #E0F2FE; -fx-background-radius: 10; -fx-min-width: 44; -fx-min-height: 44;">
                    <FontIcon iconLiteral="fas-paper-plane" iconSize="20" iconColor="#0284C7"/>
                </StackPane>
                <VBox spacing="2">
                    <Label fx:id="totalApplicationsLabel" text="0" style="-fx-text-fill: #111827; -fx-font-size: 24px; -fx-font-weight: 700;"/>
                    <Label text="Applications" style="-fx-text-fill: #6B7280; -fx-font-size: 13px;"/>
                </VBox>
            </HBox>
        </VBox>
        
        <VBox styleClass="stat-card-modern" HBox.hgrow="ALWAYS" spacing="12">
            <HBox alignment="CENTER_LEFT" spacing="12">
                <StackPane style="-fx-background-color: #FEF3C7; -fx-background-radius: 10; -fx-min-width: 44; -fx-min-height: 44;">
                    <FontIcon iconLiteral="fas-clock" iconSize="20" iconColor="#D97706"/>
                </StackPane>
                <VBox spacing="2">
                    <Label fx:id="pendingLabel" text="0" style="-fx-text-fill: #111827; -fx-font-size: 24px; -fx-font-weight: 700;"/>
                    <Label text="Pending" style="-fx-text-fill: #6B7280; -fx-font-size: 13px;"/>
                </VBox>
            </HBox>
        </VBox>
        
        <VBox styleClass="stat-card-modern" HBox.hgrow="ALWAYS" spacing="12">
            <HBox alignment="CENTER_LEFT" spacing="12">
                <StackPane style="-fx-background-color: #DCFCE7; -fx-background-radius: 10; -fx-min-width: 44; -fx-min-height: 44;">
                    <FontIcon iconLiteral="fas-calendar-check" iconSize="20" iconColor="#16A34A"/>
                </StackPane>
                <VBox spacing="2">
                    <Label fx:id="interviewsLabel" text="0" style="-fx-text-fill: #111827; -fx-font-size: 24px; -fx-font-weight: 700;"/>
                    <Label text="Interviews" style="-fx-text-fill: #6B7280; -fx-font-size: 13px;"/>
                </VBox>
            </HBox>
        </VBox>
        
        <VBox styleClass="stat-card-modern" HBox.hgrow="ALWAYS" spacing="12">
            <HBox alignment="CENTER_LEFT" spacing="12">
                <StackPane style="-fx-background-color: #F3E8FF; -fx-background-radius: 10; -fx-min-width: 44; -fx-min-height: 44;">
                    <FontIcon iconLiteral="fas-bookmark" iconSize="20" iconColor="#9333EA"/>
                </StackPane>
                <VBox spacing="2">
                    <Label fx:id="savedJobsLabel" text="0" style="-fx-text-fill: #111827; -fx-font-size: 24px; -fx-font-weight: 700;"/>
                    <Label text="Saved Jobs" style="-fx-text-fill: #6B7280; -fx-font-size: 13px;"/>
                </VBox>
            </HBox>
        </VBox>
    </HBox>
    
    <VBox spacing="16">
        <Label text="Quick Actions" style="-fx-text-fill: #111827; -fx-font-size: 15px; -fx-font-weight: 600;"/>
        <HBox spacing="16">
            <VBox styleClass="metric-card" HBox.hgrow="ALWAYS">
                <Label text="BROWSE JOBS" style="-fx-text-fill: #0F766E; -fx-font-size: 11px; -fx-font-weight: 700;"/>
                <Label fx:id="availableJobsMetric" text="1000+" style="-fx-text-fill: #111827; -fx-font-size: 28px; -fx-font-weight: 700;"/>
            </VBox>
            <VBox styleClass="metric-card" HBox.hgrow="ALWAYS">
                <Label text="MY CVS" style="-fx-text-fill: #0F766E; -fx-font-size: 11px; -fx-font-weight: 700;"/>
                <Label fx:id="cvsMetric" text="0" style="-fx-text-fill: #111827; -fx-font-size: 28px; -fx-font-weight: 700;"/>
            </VBox>
            <VBox styleClass="metric-card" HBox.hgrow="ALWAYS">
                <Label text="PROFILE VIEWS" style="-fx-text-fill: #0F766E; -fx-font-size: 11px; -fx-font-weight: 700;"/>
                <Label fx:id="profileViewsMetric" text="0" style="-fx-text-fill: #111827; -fx-font-size: 28px; -fx-font-weight: 700;"/>
            </VBox>
            <VBox styleClass="metric-card" HBox.hgrow="ALWAYS">
                <Label text="RESPONSES" style="-fx-text-fill: #0F766E; -fx-font-size: 11px; -fx-font-weight: 700;"/>
                <Label fx:id="responsesMetric" text="0" style="-fx-text-fill: #111827; -fx-font-size: 28px; -fx-font-weight: 700;"/>
            </VBox>
        </HBox>
    </VBox>
    
    <HBox spacing="16">
        <Button onAction="#onViewApplications" styleClass="button-outline-teal">
            <graphic>
                <HBox spacing="8" alignment="CENTER">
                    <FontIcon iconLiteral="fas-list-alt" iconSize="14" iconColor="#0F766E"/>
                    <Label text="My Applications" style="-fx-text-fill: #0F766E;"/>
                </HBox>
            </graphic>
        </Button>
        <Button onAction="#onManageCVs" styleClass="button-outline-teal">
            <graphic>
                <HBox spacing="8" alignment="CENTER">
                    <FontIcon iconLiteral="fas-file-alt" iconSize="14" iconColor="#0F766E"/>
                    <Label text="Manage CVs" style="-fx-text-fill: #0F766E;"/>
                </HBox>
            </graphic>
        </Button>
        <Button onAction="#onViewSavedJobs" styleClass="button-outline-teal">
            <graphic>
                <HBox spacing="8" alignment="CENTER">
                    <FontIcon iconLiteral="fas-heart" iconSize="14" iconColor="#0F766E"/>
                    <Label text="Saved Jobs" style="-fx-text-fill: #0F766E;"/>
                </HBox>
            </graphic>
        </Button>
    </HBox>
    
    <HBox spacing="24">
        <VBox spacing="16" styleClass="card-modern" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT">
                <Label text="Recent Applications" style="-fx-text-fill: #111827; -fx-font-size: 16px; -fx-font-weight: 600;" HBox.hgrow="ALWAYS"/>
                <Hyperlink text="View all" onAction="#onViewApplications" style="-fx-text-fill: #0F766E;"/>
            </HBox>
            <VBox fx:id="recentApplicationsList" spacing="12">
            </VBox>
        </VBox>
        
        <VBox spacing="16" styleClass="card-modern" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT">
                <Label text="Recommended Jobs" style="-fx-text-fill: #111827; -fx-font-size: 16px; -fx-font-weight: 600;" HBox.hgrow="ALWAYS"/>
                <Hyperlink text="Browse all" onAction="#onBrowseJobs" style="-fx-text-fill: #0F766E;"/>
            </HBox>
            <VBox fx:id="recommendedJobsContainer" spacing="12">
            </VBox>
        </VBox>
    </HBox>
</VBox>
