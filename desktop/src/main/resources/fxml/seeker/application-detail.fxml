<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.jobos.desktop.controller.seeker.ApplicationDetailController"
      style="-fx-background-color: #FAFAFA;">
    
    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-border-width: 0;">
        <VBox spacing="20" style="-fx-padding: 24;">
            
            <!-- Back button and header -->
            <HBox alignment="CENTER_LEFT" spacing="12">
                <Button onAction="#onBack" style="-fx-background-color: transparent; -fx-cursor: hand;">
                    <graphic>
                        <HBox alignment="CENTER" spacing="6">
                            <FontIcon iconLiteral="fas-arrow-left" iconSize="14" iconColor="#6B7280"/>
                            <Label text="Back to Applications" style="-fx-text-fill: #6B7280; -fx-font-size: 13px;"/>
                        </HBox>
                    </graphic>
                </Button>
            </HBox>
            
            <!-- Main content card -->
            <VBox spacing="0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #E5E7EB; -fx-border-width: 1; -fx-border-radius: 12;">
                
                <!-- Job Info Header -->
                <VBox spacing="12" style="-fx-padding: 24; -fx-border-color: #E5E7EB; -fx-border-width: 0 0 1 0;">
                    
                    <HBox alignment="CENTER_LEFT" spacing="16">
                        <!-- Job icon -->
                        <StackPane style="-fx-background-color: #F0FDFA; -fx-background-radius: 12; -fx-min-width: 56; -fx-min-height: 56;">
                            <FontIcon iconLiteral="fas-briefcase" iconSize="24" iconColor="#0F766E"/>
                        </StackPane>
                        
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label fx:id="jobTitleLabel" text="Job Title" 
                                   style="-fx-text-fill: #111827; -fx-font-size: 20px; -fx-font-weight: 700;"/>
                            <HBox alignment="CENTER_LEFT" spacing="8">
                                <FontIcon iconLiteral="fas-building" iconSize="12" iconColor="#6B7280"/>
                                <Label fx:id="companyLabel" text="Company" 
                                       style="-fx-text-fill: #6B7280; -fx-font-size: 14px;"/>
                                <Label text="•" style="-fx-text-fill: #D1D5DB;"/>
                                <FontIcon iconLiteral="fas-map-marker-alt" iconSize="12" iconColor="#6B7280"/>
                                <Label fx:id="locationLabel" text="Location" 
                                       style="-fx-text-fill: #6B7280; -fx-font-size: 14px;"/>
                            </HBox>
                        </VBox>
                        
                        <Button text="View Job" onAction="#onViewJob"
                                style="-fx-background-color: #F3F4F6; -fx-text-fill: #374151; -fx-padding: 8 16; -fx-background-radius: 8; -fx-cursor: hand;">
                            <graphic>
                                <FontIcon iconLiteral="fas-external-link-alt" iconSize="12" iconColor="#6B7280"/>
                            </graphic>
                        </Button>
                    </HBox>
                    
                    <HBox alignment="CENTER_LEFT" spacing="16">
                        <HBox fx:id="statusBadgeContainer" alignment="CENTER_LEFT">
                            <!-- Status badge will be inserted here -->
                        </HBox>
                        <Label fx:id="appliedDateLabel" text="Applied on ..." 
                               style="-fx-text-fill: #9CA3AF; -fx-font-size: 13px;"/>
                    </HBox>
                    
                </VBox>
                
                <!-- Application Content -->
                <VBox spacing="24" style="-fx-padding: 24;">
                    
                    <!-- Cover Letter Section -->
                    <VBox fx:id="coverLetterContainer" spacing="12">
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <FontIcon iconLiteral="fas-envelope-open-text" iconSize="16" iconColor="#0F766E"/>
                            <Label text="Cover Letter" 
                                   style="-fx-text-fill: #111827; -fx-font-size: 16px; -fx-font-weight: 600;"/>
                        </HBox>
                        
                        <VBox style="-fx-background-color: #F9FAFB; -fx-background-radius: 8; -fx-padding: 16;">
                            <Label fx:id="coverLetterContent" wrapText="true"
                                   style="-fx-text-fill: #374151; -fx-font-size: 14px; -fx-line-spacing: 4;"/>
                        </VBox>
                    </VBox>
                    
                    <!-- CV Section -->
                    <VBox fx:id="cvContainer" spacing="12">
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <FontIcon iconLiteral="fas-file-alt" iconSize="16" iconColor="#0F766E"/>
                            <Label text="Submitted CV" 
                                   style="-fx-text-fill: #111827; -fx-font-size: 16px; -fx-font-weight: 600;"/>
                        </HBox>
                        
                        <HBox alignment="CENTER_LEFT" spacing="16" 
                              style="-fx-background-color: #F9FAFB; -fx-background-radius: 8; -fx-padding: 16;">
                            
                            <StackPane style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #E5E7EB; -fx-border-width: 1; -fx-border-radius: 8; -fx-min-width: 48; -fx-min-height: 56;">
                                <FontIcon iconLiteral="fas-file-pdf" iconSize="24" iconColor="#DC2626"/>
                            </StackPane>
                            
                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                <Label fx:id="cvInfoLabel" text="CV submitted with this application" 
                                       style="-fx-text-fill: #374151; -fx-font-size: 14px; -fx-font-weight: 500;"/>
                                <Label text="Click to download or view" 
                                       style="-fx-text-fill: #9CA3AF; -fx-font-size: 12px;"/>
                            </VBox>
                            
                            <Button text="Download" onAction="#onDownloadCV"
                                    style="-fx-background-color: #0F766E; -fx-text-fill: white; -fx-padding: 8 16; -fx-background-radius: 8; -fx-cursor: hand;">
                                <graphic>
                                    <FontIcon iconLiteral="fas-download" iconSize="12" iconColor="white"/>
                                </graphic>
                            </Button>
                        </HBox>
                        
                        <!-- CV Preview Container (Optional) -->
                        <StackPane fx:id="cvPreviewContainer" visible="false" managed="false"
                                   style="-fx-background-color: white; -fx-border-color: #E5E7EB; -fx-border-width: 1; -fx-border-radius: 8;" prefHeight="400">
                            <!-- Preview content would go here -->
                        </StackPane>
                    </VBox>
                    
                    <!-- Custom Answers Section -->
                    <VBox fx:id="answersContainer" spacing="12" visible="false" managed="false">
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <FontIcon iconLiteral="fas-question-circle" iconSize="16" iconColor="#0F766E"/>
                            <Label text="Application Questions" 
                                   style="-fx-text-fill: #111827; -fx-font-size: 16px; -fx-font-weight: 600;"/>
                        </HBox>
                        
                        <VBox fx:id="answersContent" spacing="16" 
                              style="-fx-background-color: #F9FAFB; -fx-background-radius: 8; -fx-padding: 16;">
                            <!-- Answers will be loaded here -->
                        </VBox>
                    </VBox>
                    
                </VBox>
                
            </VBox>
            
            <!-- Timeline section for status updates (future enhancement) -->
            <VBox spacing="12" style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #E5E7EB; -fx-border-width: 1; -fx-border-radius: 12; -fx-padding: 20;">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <FontIcon iconLiteral="fas-history" iconSize="16" iconColor="#0F766E"/>
                    <Label text="Application Timeline" 
                           style="-fx-text-fill: #111827; -fx-font-size: 16px; -fx-font-weight: 600;"/>
                </HBox>
                <Label text="Your application is being reviewed. We'll notify you of any updates." 
                       style="-fx-text-fill: #6B7280; -fx-font-size: 13px;"/>
            </VBox>
            
        </VBox>
    </ScrollPane>
    
    <!-- Loading Overlay -->
    <VBox fx:id="loadingContainer" alignment="CENTER" spacing="12" 
          style="-fx-background-color: rgba(255,255,255,0.9);"
          visible="false" managed="false">
        <ProgressIndicator prefWidth="40" prefHeight="40"/>
        <Label text="Loading application..." style="-fx-text-fill: #6B7280; -fx-font-size: 14px;"/>
    </VBox>
    
</StackPane>
