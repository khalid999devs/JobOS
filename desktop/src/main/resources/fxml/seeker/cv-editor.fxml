<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.jobos.desktop.controller.seeker.CvEditorController"
      style="-fx-background-color: #FFFFFF;">
    
    <!-- Main Editor Layout - Full Screen Figma Style -->
    <BorderPane>
        
        <!-- Top Toolbar -->
        <top>
            <HBox alignment="CENTER_LEFT" spacing="16" style="-fx-background-color: #FFFFFF; -fx-border-color: #E5E7EB; -fx-border-width: 0 0 1 0; -fx-padding: 8 16;">
                
                <Button onAction="#onBack" style="-fx-background-color: transparent; -fx-cursor: hand;">
                    <graphic>
                        <FontIcon iconLiteral="fas-arrow-left" iconSize="14" iconColor="#374151"/>
                    </graphic>
                </Button>
                
                <Separator orientation="VERTICAL" style="-fx-background-color: #E5E7EB;"/>
                
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <FontIcon iconLiteral="fas-file-alt" iconSize="14" iconColor="#0F766E"/>
                    <TextField fx:id="titleField" promptText="Untitled CV" prefWidth="200"
                               style="-fx-background-color: transparent; -fx-border-width: 0; -fx-text-fill: #111827; -fx-font-size: 14px; -fx-font-weight: 600;"/>
                </HBox>
                
                <Label fx:id="lastSavedLabel" text="All changes saved" style="-fx-text-fill: #059669; -fx-font-size: 11px;"/>
                
                <Region HBox.hgrow="ALWAYS"/>
                
                <!-- Zoom controls -->
                <HBox alignment="CENTER" spacing="6" style="-fx-background-color: #F3F4F6; -fx-background-radius: 6; -fx-padding: 6 14; -fx-min-height: 36; -fx-max-height: 36;">
                    <Button fx:id="zoomOutBtn" onAction="#onZoomOut" style="-fx-background-color: transparent; -fx-cursor: hand; -fx-padding: 4;">
                        <graphic>
                            <FontIcon iconLiteral="fas-minus" iconSize="12" iconColor="#374151"/>
                        </graphic>
                    </Button>
                    <Label fx:id="zoomLabel" text="100%" style="-fx-text-fill: #374151; -fx-font-size: 13px; -fx-min-width: 45; -fx-font-weight: 500;"/>
                    <Button fx:id="zoomInBtn" onAction="#onZoomIn" style="-fx-background-color: transparent; -fx-cursor: hand; -fx-padding: 4;">
                        <graphic>
                            <FontIcon iconLiteral="fas-plus" iconSize="12" iconColor="#374151"/>
                        </graphic>
                    </Button>
                </HBox>
                
                <Button fx:id="previewBtn" onAction="#onPreview" style="-fx-background-color: #F3F4F6; -fx-text-fill: #374151; -fx-padding: 8 16; -fx-background-radius: 6; -fx-cursor: hand; -fx-min-height: 36; -fx-max-height: 36;">
                    <graphic>
                        <HBox alignment="CENTER" spacing="6">
                            <FontIcon iconLiteral="fas-eye" iconSize="12" iconColor="#374151"/>
                            <Label text="Preview" style="-fx-text-fill: #374151; -fx-font-size: 13px; -fx-font-weight: 500;"/>
                        </HBox>
                    </graphic>
                </Button>
                
                <Button fx:id="exportBtn" onAction="#onExport" style="-fx-background-color: #F3F4F6; -fx-text-fill: #374151; -fx-padding: 8 16; -fx-background-radius: 6; -fx-cursor: hand; -fx-min-height: 36; -fx-max-height: 36;">
                    <graphic>
                        <HBox alignment="CENTER" spacing="6">
                            <FontIcon iconLiteral="fas-download" iconSize="12" iconColor="#374151"/>
                            <Label text="Export" style="-fx-text-fill: #374151; -fx-font-size: 13px; -fx-font-weight: 500;"/>
                        </HBox>
                    </graphic>
                </Button>
                
                <Button fx:id="saveBtn" text="Save" onAction="#onSave"
                        style="-fx-background-color: #0F766E; -fx-text-fill: white; -fx-padding: 8 20; -fx-background-radius: 6; -fx-cursor: hand; -fx-font-size: 13px; -fx-font-weight: 600; -fx-min-height: 36; -fx-max-height: 36;">
                </Button>
                
            </HBox>
        </top>
        
        <!-- Main Content - 3 Panel Layout -->
        <center>
            <HBox spacing="0">
                
                <!-- LEFT PANEL: Sections List -->
                <VBox prefWidth="260" minWidth="220" style="-fx-background-color: #FFFFFF; -fx-border-color: #E5E7EB; -fx-border-width: 0 1 0 0;">
                    
                    <!-- Panel Header -->
                    <HBox alignment="CENTER_LEFT" spacing="8" style="-fx-padding: 12 16; -fx-border-color: #E5E7EB; -fx-border-width: 0 0 1 0;">
                        <FontIcon iconLiteral="fas-layer-group" iconSize="12" iconColor="#374151"/>
                        <Label text="Sections" style="-fx-text-fill: #111827; -fx-font-size: 12px; -fx-font-weight: 600;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button onAction="#onAddSection" style="-fx-background-color: #0F766E; -fx-padding: 4 8; -fx-background-radius: 4; -fx-cursor: hand;">
                            <graphic>
                                <FontIcon iconLiteral="fas-plus" iconSize="10" iconColor="white"/>
                            </graphic>
                        </Button>
                    </HBox>
                    
                    <!-- Sections List (Draggable) -->
                    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-border-width: 0;" VBox.vgrow="ALWAYS">
                        <VBox fx:id="sectionsList" spacing="6" style="-fx-padding: 10;">
                            <!-- Section items will be loaded here -->
                        </VBox>
                    </ScrollPane>
                    
                    <!-- Template Selector -->
                    <VBox style="-fx-background-color: #F9FAFB; -fx-padding: 12; -fx-border-color: #E5E7EB; -fx-border-width: 1 0 0 0;">
                        <Label text="TEMPLATE" style="-fx-text-fill: #6B7280; -fx-font-size: 10px; -fx-font-weight: 600;"/>
                        <HBox alignment="CENTER_LEFT" spacing="8" style="-fx-padding: 8 0 0 0;">
                            <FontIcon iconLiteral="fas-palette" iconSize="14" iconColor="#0F766E"/>
                            <Label fx:id="templateLabel" text="Professional" style="-fx-text-fill: #111827; -fx-font-size: 12px;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button onAction="#onChangeTemplate" style="-fx-background-color: transparent; -fx-cursor: hand;">
                                <graphic>
                                    <FontIcon iconLiteral="fas-chevron-right" iconSize="10" iconColor="#6B7280"/>
                                </graphic>
                            </Button>
                        </HBox>
                    </VBox>
                    
                </VBox>
                
                <!-- CENTER: Live Preview Canvas -->
                <VBox HBox.hgrow="ALWAYS" style="-fx-background-color: #F9FAFB;">
                    
                    <!-- Preview Header -->
                    <HBox alignment="CENTER" style="-fx-padding: 8; -fx-background-color: #FFFFFF; -fx-border-color: #E5E7EB; -fx-border-width: 0 0 1 0;">
                        <Label text="LIVE PREVIEW" style="-fx-text-fill: #6B7280; -fx-font-size: 10px; -fx-font-weight: 600;"/>
                    </HBox>
                    
                    <!-- Preview Area with Paper Effect -->
                    <ScrollPane fx:id="previewScrollPane" fitToWidth="true" style="-fx-background-color: #F9FAFB; -fx-border-width: 0;" VBox.vgrow="ALWAYS">
                        <StackPane style="-fx-padding: 40;">
                            <VBox fx:id="previewContent" maxWidth="700" alignment="TOP_CENTER"
                                  style="-fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 20, 0, 0, 4); -fx-padding: 48;">
                                <!-- Live preview content will be rendered here -->
                                <Label text="Your CV preview will appear here" style="-fx-text-fill: #9CA3AF; -fx-font-size: 14px;"/>
                            </VBox>
                        </StackPane>
                    </ScrollPane>
                    
                </VBox>
                
                <!-- RIGHT PANEL: Properties/Editor -->
                <VBox fx:id="propertiesPanel" prefWidth="320" minWidth="280" style="-fx-background-color: #FFFFFF; -fx-border-color: #E5E7EB; -fx-border-width: 0 0 0 1;">
                    
                    <!-- Panel Header -->
                    <HBox alignment="CENTER_LEFT" spacing="8" style="-fx-padding: 12 16; -fx-border-color: #E5E7EB; -fx-border-width: 0 0 1 0;">
                        <FontIcon iconLiteral="fas-sliders-h" iconSize="12" iconColor="#374151"/>
                        <Label fx:id="propertiesTitle" text="Properties" style="-fx-text-fill: #111827; -fx-font-size: 12px; -fx-font-weight: 600;"/>
                    </HBox>
                    
                    <!-- Properties Content -->
                    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-border-width: 0;" VBox.vgrow="ALWAYS">
                        <VBox fx:id="propertiesContent" spacing="16" style="-fx-padding: 16;">
                            <!-- Default: No section selected -->
                            <VBox alignment="CENTER" spacing="12" style="-fx-padding: 40 20;">
                                <FontIcon iconLiteral="fas-hand-pointer" iconSize="32" iconColor="#4B5563"/>
                                <Label text="Select a section" style="-fx-text-fill: #9CA3AF; -fx-font-size: 13px;"/>
                                <Label text="Click on a section from the left panel to edit its content and properties" 
                                       style="-fx-text-fill: #6B7280; -fx-font-size: 11px; -fx-text-alignment: center;" wrapText="true"/>
                            </VBox>
                        </VBox>
                    </ScrollPane>
                    
                    <!-- Quick Actions -->
                    <VBox style="-fx-background-color: #F9FAFB; -fx-padding: 12; -fx-border-color: #E5E7EB; -fx-border-width: 1 0 0 0;">
                        <Label text="QUICK ACTIONS" style="-fx-text-fill: #6B7280; -fx-font-size: 10px; -fx-font-weight: 600;"/>
                        <HBox spacing="8" style="-fx-padding: 8 0 0 0;">
                            <Button onAction="#onDuplicate" style="-fx-background-color: #F3F4F6; -fx-padding: 6 12; -fx-background-radius: 6; -fx-cursor: hand;" HBox.hgrow="ALWAYS">
                                <graphic>
                                    <HBox alignment="CENTER" spacing="6">
                                        <FontIcon iconLiteral="fas-copy" iconSize="11" iconColor="#374151"/>
                                        <Label text="Duplicate Section" style="-fx-text-fill: #374151; -fx-font-size: 11px;"/>
                                    </HBox>
                                </graphic>
                            </Button>
                        </HBox>
                    </VBox>
                    
                </VBox>
                
            </HBox>
        </center>
        
    </BorderPane>
    
    <!-- Loading Overlay -->
    <VBox fx:id="loadingContainer" alignment="CENTER" spacing="12" 
          style="-fx-background-color: rgba(255,255,255,0.95);"
          visible="false" managed="false">
        <ProgressIndicator prefWidth="40" prefHeight="40" style="-fx-progress-color: #0F766E;"/>
        <Label text="Loading CV..." style="-fx-text-fill: #374151; -fx-font-size: 14px;"/>
    </VBox>
    
</StackPane>
