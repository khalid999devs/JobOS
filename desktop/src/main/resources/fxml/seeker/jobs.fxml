<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.jobos.desktop.controller.seeker.SeekerJobsController"
      spacing="0" style="-fx-background-color: #FAFAFA;">
    
    <VBox style="-fx-background-color: white; -fx-border-color: #E5E7EB; -fx-border-width: 0 0 1 0;">
        <padding>
            <Insets top="24" right="28" bottom="20" left="28"/>
        </padding>
        
        <HBox alignment="CENTER_LEFT" spacing="12">
            <VBox spacing="4">
                <Label text="Browse Jobs" style="-fx-text-fill: #111827; -fx-font-size: 22px; -fx-font-weight: 700;"/>
                <Label fx:id="resultsLabel" text="Find your next opportunity" style="-fx-text-fill: #6B7280; -fx-font-size: 13px;"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="savedJobsBtn" onAction="#onSavedJobs" styleClass="button-outline-teal">
                <graphic>
                    <HBox spacing="6" alignment="CENTER">
                        <FontIcon iconLiteral="far-heart" iconSize="14" iconColor="#0F766E"/>
                        <Label text="Saved Jobs" style="-fx-text-fill: #0F766E; -fx-font-size: 13px;"/>
                    </HBox>
                </graphic>
            </Button>
        </HBox>
        
        <HBox spacing="12" style="-fx-padding: 16 0 0 0;">
            <HBox styleClass="search-input-container" HBox.hgrow="ALWAYS" alignment="CENTER_LEFT" spacing="10">
                <FontIcon iconLiteral="fas-search" iconSize="14" iconColor="#9CA3AF"/>
                <TextField fx:id="searchField" promptText="Job title, keywords, or company..." 
                           styleClass="search-input" HBox.hgrow="ALWAYS"/>
            </HBox>
            
            <HBox styleClass="search-input-container" alignment="CENTER_LEFT" spacing="10" style="-fx-min-width: 200;">
                <FontIcon iconLiteral="fas-map-marker-alt" iconSize="14" iconColor="#9CA3AF"/>
                <TextField fx:id="locationField" promptText="Location..." 
                           styleClass="search-input" HBox.hgrow="ALWAYS"/>
            </HBox>
            
            <Button onAction="#onSearch" styleClass="button-primary-teal">
                <graphic>
                    <HBox spacing="6" alignment="CENTER">
                        <FontIcon iconLiteral="fas-search" iconSize="13" iconColor="white"/>
                        <Label text="Search" style="-fx-text-fill: white; -fx-font-weight: 600;"/>
                    </HBox>
                </graphic>
            </Button>
        </HBox>
        
        <HBox spacing="8" style="-fx-padding: 14 0 0 0;" alignment="CENTER_LEFT">
            <ComboBox fx:id="workModeCombo" promptText="Work Mode" styleClass="filter-combo"/>
            <ComboBox fx:id="jobTypeCombo" promptText="Job Type" styleClass="filter-combo"/>
            <ComboBox fx:id="experienceCombo" promptText="Experience" styleClass="filter-combo"/>
            <ComboBox fx:id="salaryRangeCombo" promptText="Salary Range" styleClass="filter-combo"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="clearFiltersBtn" onAction="#onClearFilters" styleClass="button-text-subtle" text="Clear Filters"/>
        </HBox>
    </VBox>
    
    <StackPane VBox.vgrow="ALWAYS">
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;">
            <VBox fx:id="jobsList" spacing="12" style="-fx-padding: 16 28 28 28;">
            </VBox>
        </ScrollPane>
        
        <VBox fx:id="loadingContainer" alignment="CENTER" spacing="12" visible="false" style="-fx-background-color: rgba(250,250,250,0.9);">
            <ProgressIndicator style="-fx-progress-color: #0F766E;"/>
            <Label text="Loading jobs..." style="-fx-text-fill: #6B7280;"/>
        </VBox>
        
        <VBox fx:id="emptyContainer" alignment="CENTER" spacing="16" visible="false">
            <FontIcon iconLiteral="fas-briefcase" iconSize="48" iconColor="#D1D5DB"/>
            <Label text="No jobs found" style="-fx-text-fill: #6B7280; -fx-font-size: 16px; -fx-font-weight: 600;"/>
            <Label text="Try adjusting your search or filters" style="-fx-text-fill: #9CA3AF; -fx-font-size: 13px;"/>
        </VBox>
    </StackPane>
    
    <HBox fx:id="paginationContainer" alignment="CENTER" spacing="8" 
          style="-fx-background-color: white; -fx-border-color: #E5E7EB; -fx-border-width: 1 0 0 0; -fx-padding: 12 28;">
        <Button fx:id="prevBtn" onAction="#onPrevPage" styleClass="pagination-btn" text="Previous" disable="true"/>
        <Label fx:id="pageLabel" text="Page 1 of 1" style="-fx-text-fill: #6B7280; -fx-font-size: 13px; -fx-padding: 0 16;"/>
        <Button fx:id="nextBtn" onAction="#onNextPage" styleClass="pagination-btn" text="Next" disable="true"/>
    </HBox>
</VBox>
